#!/bin/sh

if [ "$#" -eq 0 ]; then
    programname=$(basename "$0")
    echo "ERROR: No program supplied"
    echo
    echo "Usage: $programname <program>"
    exit 1
fi


# Add exe names newline separated to the string to disable LD_PRELOAD
DISABLE_LD_PRELOAD="
cs2.sh
RiseOfTheTombRaider.sh
"

# shim 路径：优先按脚本自身位置自定位，回落到构建时写入的路径。
# 这样 glibc 的“扁平布局”（<glibc>/lib/...）与“usr 布局”（<glibc>/usr/lib/...）
# 都能命中，构建前缀写错也不会让 LD_PRELOAD 指向不存在的文件。
FHUD_LIB_NAME="@ld_libdir_mangohud@libFHUD_shim.so"
_self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)
for _cand in "$_self_dir/../lib/fhud" \
             "$_self_dir/../usr/lib/fhud" \
             "$_self_dir/../lib64/fhud" \
             "$_self_dir/../lib/x86_64-linux-gnu/fhud"; do
    if [ -f "$_cand/libFHUD_shim.so" ]; then
        # 规范化，去掉 "bin/../" 这类冗余段
        FHUD_LIB_NAME="$(CDPATH= cd -- "$_cand" && pwd)/libFHUD_shim.so"
        break
    fi
done

if [ "$1" = "--version" ]; then
    echo @version@
    echo "FusionHUD appearance ported from FusionHUD by The412Banner"
    echo "  https://github.com/The412Banner/FusionHUD  (GPL-3.0)"
    exit 0
fi

# --credits / --about : 应用内致谢（关于）界面。
# FusionHUD 以 GPL-3.0 + §7(b) 附加署名条款发布，要求在应用内致谢/关于界面中
# 保留对 The412Banner 的署名及仓库链接 —— 这里就是 MangoHudfex 的该界面。
if [ "$1" = "--credits" ] || [ "$1" = "--about" ]; then
    cat <<'MANGO_CREDITS_EOF'
MangoHudfex — a MangoHud fork

  MangoHud (upstream)
    https://github.com/flightlessmango/MangoHud
    Copyright (c) 2020 flightlessmango — MIT

  FusionHUD (appearance)
    https://github.com/The412Banner/FusionHUD
    Copyright (C) The412Banner — GPL-3.0
    Ported files:
      src/fusion_theme.hpp
      src/fusion_layout.hpp
      src/fusion_appearance.hpp
      src/fusion_metrics.hpp

  FEX-Emu (stats interface)
    https://github.com/FEX-Emu/FEX — MIT
    src/fex.cpp

  License: this distribution includes GPL-3.0 code (FusionHUD) and must be
  treated as a whole under GNU GPL v3.0. See ATTRIBUTION.md.

MANGO_CREDITS_EOF
    exit 0
fi

if [ "$1" = "--dlsym" ]; then
    # no-op, dlsym enabled by default
    shift
fi

# grab all arguments from command_line
command_line="$*"
# flag for disable_preload
disable_preload=false

# Check if the script name or any of the executables in DISABLE_LD_PRELOAD are in the command line
for exe in $DISABLE_LD_PRELOAD; do
    if echo "$command_line" | grep -q "$exe"; then
        disable_preload=true
        break
    fi
done

# 升级保护：剔除环境里残留的旧 MangoHud 预载项。
# 旧路径（lib/mangohud/...、libMangoHud*.so）在新版本里已不存在，
# 继续传给 ld.so 会直接报错（“去找旧 mangohud 文件”就是这么来的）。
if [ -n "${LD_PRELOAD:-}" ]; then
    _pre=""
    _oldifs=$IFS; IFS=':'
    for _p in $LD_PRELOAD; do
        case "$_p" in
            *libMangoHud*|*/mangohud/*)
                echo "note: 已忽略旧版预载项 $_p" >&2
                ;;
            '')
                ;;
            *)
                _pre="${_pre:+$_pre:}$_p"
                ;;
        esac
    done
    IFS=$_oldifs
    LD_PRELOAD="$_pre"
fi

# ---- bionic 兼容代理层 ----
# wine 会调起 Termux(bionic) 的小工具（如 ntlm_auth），它们继承了本脚本注入的
# glibc LD_PRELOAD，bionic 链接器无法加载，报 “CANNOT LINK EXECUTABLE ... libc.so.6”。
# 这里为这些工具生成同名代理脚本：先剔除 glibc 预载/库路径，再执行真身。
# 关闭：FHUD_NO_PROXY=1        自定义清单：FHUD_PROXY_TOOLS="ntlm_auth ..."
if [ "${FHUD_NO_PROXY:-0}" != "1" ]; then
    _fhud_proxy_tools="${FHUD_PROXY_TOOLS:-ntlm_auth}"
    _fhud_proxy_dir="${TMPDIR:-/tmp}/.fhud-proxy"
    if mkdir -p "$_fhud_proxy_dir" 2>/dev/null; then
        for _fhud_tool in $_fhud_proxy_tools; do
            _fhud_tpl="$_fhud_proxy_dir/$_fhud_tool"
            cat > "$_fhud_tpl" <<'FHUD_PROXY_EOF'
#!/bin/sh
# FHUD bionic proxy: strip glibc preload/libpath, then run the real tool.
_me=${0##*/}
_self_dir=${0%/*}
_oldifs=$IFS
IFS=':'
_newpre=""
for _p in ${LD_PRELOAD:-}; do
    case "$_p" in
        *libFHUD*|*libMangoHud*|*/mangohud/*|*/fhud/*|'') ;;
        *) _newpre="${_newpre:+$_newpre:}$_p" ;;
    esac
done
_newlib=""
for _p in ${LD_LIBRARY_PATH:-}; do
    case "$_p" in
        */usr/glibc/*|*/usr/glibc|'') ;;
        *) _newlib="${_newlib:+$_newlib:}$_p" ;;
    esac
done
IFS=$_oldifs
if [ -n "$_newpre" ]; then export LD_PRELOAD="$_newpre"; else unset LD_PRELOAD; fi
if [ -n "$_newlib" ]; then export LD_LIBRARY_PATH="$_newlib"; else unset LD_LIBRARY_PATH; fi
_real=""
_oldifs=$IFS
IFS=':'
for _d in ${PATH:-}; do
    [ "$_d" = "$_self_dir" ] && continue
    if [ -x "$_d/$_me" ] && [ ! -d "$_d/$_me" ]; then _real="$_d/$_me"; break; fi
done
IFS=$_oldifs
if [ -z "$_real" ]; then
    echo "fhud-proxy: real '$_me' not found in PATH" >&2
    exit 127
fi
exec "$_real" "$@"
FHUD_PROXY_EOF
            chmod +x "$_fhud_tpl" 2>/dev/null || true
        done
        PATH="$_fhud_proxy_dir:$PATH"
        export PATH
    fi
fi
if [ "$disable_preload" = true ]; then
    exec env MANGOHUD=1 "$@"
else
    # Make sure we don't append mangohud lib multiple times
    # otherwise, this could cause issues with the steam runtime
    case ":${LD_PRELOAD-}:" in
        (*:$FHUD_LIB_NAME:*)
            ;;
        (*)
            # Preload using the plain filenames of the libs, the dynamic linker will
            # figure out whether the 32 or 64 bit version should be used
            LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}${FHUD_LIB_NAME}"
    esac

    exec env MANGOHUD=1 LD_PRELOAD="${LD_PRELOAD}" "$@"
fi
